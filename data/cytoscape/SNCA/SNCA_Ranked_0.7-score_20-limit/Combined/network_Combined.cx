,{"po":116153,"n":"@id","v":"stringdb:9606.ENSP00000331608"},{"po":116153,"n":"compartment::endoplasmic reticulum","v":"1.330052","d":"double"},{"po":116153,"n":"stringdb::description","v":"Iroquois-class homeodomain protein IRX-3; Transcription factor involved in SHH-dependent neural patterning. Together with NKX2-2 and NKX6-1 acts to restrict the generation of motor neurons to the appropriate region of the neural tube. Belongs to the class I proteins of neuronal progenitor factors, which are repressed by SHH signals. Involved in the transcriptional repression of MNX1 in non-motor neuron cells. Acts as a regulator of energy metabolism."},{"po":116153,"n":"tissue::thyroid gland","v":"1.587232","d":"double"},{"po":116153,"n":"display name","v":"IRX3"},{"po":116153,"n":"tissue::adrenal gland","v":"1.308973","d":"double"},{"po":116153,"n":"log2FoldChange","v":"1.587210342163046","d":"double"},{"po":116153,"n":"stringdb::sequence","v":""},{"po":116153,"n":"tissue::intestine","v":"1.676118","d":"double"},{"po":116153,"n":"stringdb::node color","v":"rgb(117,117,239)"},{"po":116153,"n":"stringdb::database identifier","v":"9606.ENSP00000331608"},{"po":116153,"n":"tissue::blood","v":"2.218878","d":"double"},{"po":116153,"n":"tissue::spleen","v":"1.180202","d":"double"},{"po":116150,"n":"padj","v":"1.323027993414161E-7","d":"double"},{"po":116150,"n":"stringdb::namespace","v":"stringdb"},{"po":116150,"n":"tissue::urine","v":"0.681241","d":"double"},{"po":116150,"n":"compartment::nucleus","v":"4.347342","d":"double"},{"po":116150,"n":"stringdb::structures","v":["AF-Q6PJE2"],"d":"list_of_string"},{"po":116150,"n":"tissue::saliva","v":"0.669007","d":"double"},{"po":116150,"n":"stringdb::species","v":"Homo sapiens"},{"po":116150,"n":"tissue::liver","v":"1.128543","d":"double"},{"po":116150,"n":"lfcSE","v":"0.2003773977303705","d":"double"},{"po":116150,"n":"compartment::extracellular","v":"0.65625","d":"double"},{"po":116150,"n":"tissue::stomach","v":"0.904595","d":"double"},{"po