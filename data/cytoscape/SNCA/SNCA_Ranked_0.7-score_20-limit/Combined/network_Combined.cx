91673","d":"double"},{"po":116219,"n":"stringdb::description","v":"Bone morphogenetic protein 8A; Induces cartilage and bone formation. May be the osteoinductive factor responsible for the phenomenon of epithelial osteogenesis. Plays a role in calcium regulation and bone homeostasis (By similarity). Signaling protein involved in regulation of thermogenesis and energy balance. Proposed to increase the peripheral response of brown adipose tissue (BAT) to adrenergic stimulation while acting centrally in the hypothalamus to increase sympathetic output to BAT."},{"po":116219,"n":"tissue::thyroid gland","v":"2.158673","d":"double"},{"po":116219,"n":"display name","v":"BMP8A"},{"po":116219,"n":"tissue::adrenal gland","v":"0.545455","d":"double"},{"po":116219,"n":"log2FoldChange","v":"-2.047898777533928","d":"double"},{"po":116219,"n":"stringdb::sequence","v":""},{"po":116219,"n":"tissue::intestine","v":"1.222289","d":"double"},{"po":116219,"n":"stringdb::node color","v":"rgb(133,239,117)"},{"po":116219,"n":"stringdb::database identifier","v":"9606.ENSP00000327440"},{"po":116219,"n":"tissue::blood","v":"1.785392","d":"double"},{"po":116219,"n":"tissue::spleen","v":"1.14578","d":"double"},{"po":116216,"n":"padj","v":"0.0090707216457353","d":"double"},{"po":116216,"n":"stringdb::namespace","v":"stringdb"},{"po":116216,"n":"compartment::golgi apparatus","v":"4.0","d":"double"},{"po":116216,"n":"tissue::urine","v":"0.221849","d":"double"},{"po":116216,"n":"compartment::nucleus","v":"1.431901","d":"double"},{"po":116216,"n":"stringdb::structures","v":["AF-Q6ZWE6"],"d":"list_of_string"},{"po":116216,"n":"tissue::saliva","v":"0.545455","d":"double"},{"po":116216,"n":"stringdb::species","v":"Homo sapiens"},{"po":116216,"n":"compartment::peroxisome","v":"0.879833","d":"double"},{"po":116216,"n":"tissue::liver","v":"1.461008","d":"double"},{"po":116216,"n":"lfcSE","v":"0.1283619298856532","d":"double"},{"po":116216,"n":"compartment::extracellular","v":"1.064289","d":"double"},{"po":1