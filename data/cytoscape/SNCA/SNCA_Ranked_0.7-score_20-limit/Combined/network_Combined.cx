C"},{"po":116048,"n":"gene_symbol","v":"HNRNPC"},{"po":116048,"n":"pvalue","v":"3.658652056628386E-8","d":"double"},{"po":116048,"n":"compartment::plasma membrane","v":"2.092505","d":"double"},{"po":116048,"n":"stringdb::imageurl","v":"https://version-12-0.string-db.org//images/Proteinpictures/pdb/2m/2mz1_A.png"},{"po":116048,"n":"tissue::kidney","v":"4.263313","d":"double"},{"po":116048,"n":"baseMean","v":"7848.237139731617","d":"double"},{"po":116048,"n":"@id","v":"stringdb:9606.ENSP00000451291"},{"po":116048,"n":"compartment::endoplasmic reticulum","v":"1.966109","d":"double"},{"po":116048,"n":"stringdb::description","v":"Heterogeneous nuclear ribonucleoproteins C1/C2; Binds pre-mRNA and nucleates the assembly of 40S hnRNP particles. Interacts with poly-U tracts in the 3'-UTR or 5'-UTR of mRNA and modulates the stability and the level of translation of bound mRNA molecules. Single HNRNPC tetramers bind 230-240 nucleotides. Trimers of HNRNPC tetramers bind 700 nucleotides. May play a role in the early steps of spliceosome assembly and pre-mRNA splicing. N6-methyladenosine (m6A) has been shown to alter the local structure in mRNAs and long non-coding RNAs (lncRNAs) via a mechanism named 'm(6)A-switch', fa [...] "},{"po":116048,"n":"tissue::thyroid gland","v":"2.951644","d":"double"},{"po":116048,"n":"display name","v":"HNRNPC"},{"po":116048,"n":"tissue::adrenal gland","v":"2.848668","d":"double"},{"po":116048,"n":"tissue::gall bladder","v":"2.344833","d":"double"},{"po":116048,"n":"log2FoldChange","v":"-0.3585872163927826","d":"double"},{"po":116048,"n":"stringdb::sequence","v":""},{"po":116048,"n":"tissue::intestine","v":"4.304402","d":"double"},{"po":116048,"n":"stringdb::node color","v":"rgb(239,207,117)"},{"po":116048,"n":"stringdb::database identifier","v":"9606.ENSP00000451291"},{"po":116048,"n":"tissue::blood","v":"4.894838","d":"double"},{"po":116048,"n":"tissue::spleen","v":"3.257704","d":"double"},{"po":116045,"n":"padj","v":"0.0016172600489216","d":"doub