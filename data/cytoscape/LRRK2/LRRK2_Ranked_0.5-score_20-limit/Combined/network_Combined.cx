ation of the germ layers in  [...] "},{"po":121157,"n":"tissue::thyroid gland","v":"1.180835","d":"double"},{"po":121157,"n":"display name","v":"CBX2"},{"po":121157,"n":"tissue::adrenal gland","v":"1.447401","d":"double"},{"po":121157,"n":"tissue::gall bladder","v":"0.181818","d":"double"},{"po":121157,"n":"log2FoldChange","v":"-0.5401149220637188","d":"double"},{"po":121157,"n":"stringdb::sequence","v":""},{"po":121157,"n":"tissue::intestine","v":"1.778788","d":"double"},{"po":121157,"n":"stringdb::node color","v":"rgb(117,190,239)"},{"po":121157,"n":"stringdb::database identifier","v":"9606.ENSP00000308750"},{"po":121157,"n":"tissue::blood","v":"4.391334","d":"double"},{"po":121157,"n":"tissue::spleen","v":"1.454114","d":"double"},{"po":121151,"n":"stringdb::namespace","v":"stringdb"},{"po":121151,"n":"tissue::urine","v":"1.193125","d":"double"},{"po":121151,"n":"compartment::nucleus","v":"5.0","d":"double"},{"po":121151,"n":"stringdb::structures","v":["AF-Q8IY57"],"d":"list_of_string"},{"po":121151,"n":"tissue::saliva","v":"1.090909","d":"double"},{"po":121151,"n":"stringdb::species","v":"Homo sapiens"},{"po":121151,"n":"tissue::liver","v":"1.997886","d":"double"},{"po":121151,"n":"compartment::extracellular","v":"0.709141","d":"double"},{"po":121151,"n":"tissue::stomach","v":"1.090909","d":"double"},{"po":121151,"n":"tissue::bone marrow","v":"1.823539","d":"double"},{"po":121151,"n":"tissue::heart","v":"2.12654","d":"double"},{"po":121151,"n":"stringdb::enhancedLabel Passthrough","v":"label: attribute=\"display name\" labelsize=12 labelAlignment=left position=northeast outline=true outlineColor=white outlineTransparency=95 outlineWidth=10 background=false color=black dropShadow=false"},{"po":121151,"n":"stringdb::canonical name","v":"YAF2_HUMAN"},{"po":121151,"n":"tissue::eye","v":"0.533333","d":"double"},{"po":121151,"n":"compartment::cytoskeleton","v":"0.788376","d":"double"},{"po":121151,"n":"tissue::nervous system","v":"4.777788","d":"double"},{"po":121151,"