nction."},{"po":120869,"n":"tissue::thyroid gland","v":"0.855625","d":"double"},{"po":120869,"n":"display name","v":"AK7"},{"po":120869,"n":"tissue::adrenal gland","v":"1.125139","d":"double"},{"po":120869,"n":"tissue::gall bladder","v":"0.545455","d":"double"},{"po":120869,"n":"log2FoldChange","v":"1.0642722641582727","d":"double"},{"po":120869,"n":"stringdb::sequence","v":""},{"po":120869,"n":"tissue::intestine","v":"1.264701","d":"double"},{"po":120869,"n":"stringdb::node color","v":"rgb(117,239,125)"},{"po":120869,"n":"stringdb::database identifier","v":"9606.ENSP00000267584"},{"po":120869,"n":"tissue::blood","v":"1.643899","d":"double"},{"po":120869,"n":"tissue::spleen","v":"1.386724","d":"double"},{"po":120866,"n":"padj","v":"0.0334919537182018","d":"double"},{"po":120866,"n":"stringdb::namespace","v":"stringdb"},{"po":120866,"n":"compartment::golgi apparatus","v":"0.815877","d":"double"},{"po":120866,"n":"tissue::urine","v":"0.647597","d":"double"},{"po":120866,"n":"compartment::nucleus","v":"1.586947","d":"double"},{"po":120866,"n":"stringdb::structures","v":["1taz_A","AF-Q01064"],"d":"list_of_string"},{"po":120866,"n":"tissue::saliva","v":"0.181818","d":"double"},{"po":120866,"n":"stringdb::species","v":"Homo sapiens"},{"po":120866,"n":"compartment::peroxisome","v":"0.501904","d":"double"},{"po":120866,"n":"tissue::liver","v":"1.591989","d":"double"},{"po":120866,"n":"lfcSE","v":"0.3731093069834932","d":"double"},{"po":120866,"n":"compartment::extracellular","v":"1.458351","d":"double"},{"po":120866,"n":"tissue::stomach","v":"0.608787","d":"double"},{"po":120866,"n":"tissue::bone marrow","v":"0.548185","d":"double"},{"po":120866,"n":"compartment::endosome","v":"0.751574","d":"double"},{"po":120866,"n":"tissue::heart","v":"2.15481","d":"double"},{"po":120866,"n":"compartment::lysosome","v":"0.89667","d":"double"},{"po":120866,"n":"stringdb::enhancedLabel Passthrough","v":"label: attribute=\"display name\" labelsize=12 labelAlignment=left position=northeast o