ndent inactivation of CACNA1C. Positively regulates calcium-activated potassium channel activity of KCNN2."},{"po":120860,"n":"tissue::thyroid gland","v":"2.896111","d":"double"},{"po":120860,"n":"display name","v":"CALM3"},{"po":120860,"n":"tissue::adrenal gland","v":"2.936657","d":"double"},{"po":120860,"n":"tissue::gall bladder","v":"1.91189","d":"double"},{"po":120860,"n":"stringdb::sequence","v":"MADQLTEEQIAEFKEAFSLFDKDGDGTITTKELGTVMRSLGQNPTEAELQDMINEVDADGNGTIDFPEFLTMMARKMKDTDSEEEIREAFRVFDKDGNGYISAAELRHVMTNLGEKLTDEEVDEMIREADIDGDGQVNYEEFVQMMTAK"},{"po":120860,"n":"tissue::intestine","v":"4.407325","d":"double"},{"po":120860,"n":"stringdb::database identifier","v":"9606.ENSP00000291295"},{"po":120860,"n":"tissue::blood","v":"4.824923","d":"double"},{"po":120860,"n":"tissue::spleen","v":"3.345345","d":"double"},{"po":120854,"n":"stringdb::namespace","v":"stringdb"},{"po":120854,"n":"compartment::golgi apparatus","v":"2.441395","d":"double"},{"po":120854,"n":"tissue::urine","v":"2.299709","d":"double"},{"po":120854,"n":"compartment::nucleus","v":"3.654371","d":"double"},{"po":120854,"n":"stringdb::structures","v":["1ggz_A","AF-P27482"],"d":"list_of_string"},{"po":120854,"n":"tissue::saliva","v":"3.048672","d":"double"},{"po":120854,"n":"stringdb::species","v":"Homo sapiens"},{"po":120854,"n":"compartment::peroxisome","v":"2.118865","d":"double"},{"po":120854,"n":"tissue::liver","v":"3.048705","d":"double"},{"po":120854,"n":"compartment::extracellular","v":"4.656113","d":"double"},{"po":120854,"n":"tissue::stomach","v":"2.876485","d":"double"},{"po":120854,"n":"tissue::bone marrow","v":"2.32516","d":"double"},{"po":120854,"n":"compartment::endosome","v":"2.507575","d":"double"},{"po":120854,"n":"tissue::heart","v":"3.466833","d":"double"},{"po":120854,"n":"compartment::lysosome","v":"2.556398","d":"double"},{"po":120854,"n":"stringdb::enhancedLabel Passthrough","v":"label: attribute=\"display name\" labelsize=12 labelAlignment=left position=northeast outline=true ou